# Copy this file to ".env" and fill in the values you need.

# Optional - a random one is generated automatically if empty
SECRET_KEY=

# Needed for "Continue with Google" (see README: "Continue with Google")
GOOGLE_CLIENT_ID=

# Needed to play songs inside the page (see README: "Play songs inside the website")
YOUTUBE_API_KEY=

# Optional - use a different songs file (lyrics.db must sit next to it)
# SONGS_FILE=data/songs.csv

# Optional - country used to skip videos that are blocked there (default IN)
# YOUTUBE_REGION=IN

# --- Admin panel (/admin/login). Use a LONG password. Admin stays disabled while this is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Set to "production" on your hosting service (secure cookies, proxy headers)
APP_ENV=
